  "schema_version": 1,
  "description": "Agent-authored sentence-level estimates of intended semantic ISP adjustments. These are hypotheses, not autotuned or human-validated parameters.",
  "moran_guideline": "D1 and D3: technical or visual; D2: perceptual; D4: cultural or associative, following the existing project interpretation of Moran slides 9-10.",
  "rating_scale": {
    "minimum": -1.0,
    "maximum": 1.0,
    "zero": "No adjustment inferred from the text alone; zero can also mean the request is unsupported or ambiguous, not proof that the effect is objectively absent.",
    "strength": "Approximate subjective direction and relative intensity, not a physical ISP setting, a probability, or an autotune result.",
    "reference": "Relative adjustment from a neutral, well-exposed starting image; actual settings may depend on the input image."
  },
  "controls": {
    "warmth": "Negative: cooler; positive: warmer white balance.",
    "saturation": "Negative: less saturated; positive: more saturated.",
    "brightness": "Negative: darker; positive: brighter. Corresponds directionally to tone_gain, whose physical neutral is 1.",
    "contrast": "Negative: lower contrast; positive: higher contrast. Physical neutral is 1.",
    "sharpness": "Negative: blur or softer detail; positive: sharper detail.",
    "palette": "Negative: magenta-green attraction; positive: teal-orange attraction. Zero for unspecified or unrelated color palettes."
  },
  "ambiguity_levels": {
    "direct": "Explicitly names the intended control and direction.",
    "low": "Visually descriptive request with a reasonably clear intended adjustment.",
    "medium": "Perceptual or aesthetic request with several plausible interpretations.",
    "high": "Cultural, emotional, contextual, or unrelated request whose ISP implications are uncertain."
  },
